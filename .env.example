# cp .env.example .env

FUNASR_VERSION=1.0.0
FUNASR_DEVICE=cuda

# HTTP API 模型（funasr-server 默认就是 sensevoice，通常不需要改）
# 如需修改，在 docker-compose 的 funasr-api command 里加 --model 参数

# WebSocket 模型
WS_ASR_MODEL=iic/SenseVoiceSmall
WS_ASR_ONLINE_MODEL=iic/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online
WS_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch

WS_PORT=10095

# API 鉴权
FUNASR_API_KEY=funasr-internal    # 内网使用的 API key，客户端请求时带 Authorization: Bearer funasr-internal

# Nginx
NGINX_HTTP_PORT=80

# 日志
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# ── CosyVoice2 TTS ──
COSYVOICE_VERSION=1.0.0
# ModelScope 实际落盘目录名是 iic_CosyVoice2-0.5B（单个下划线，不是 iic/CosyVoice2-0.5B 子目录）。
# 由 scripts/download_models.sh --tts-only 下载后自动生成，此处默认值已按真实路径配置
COSYVOICE_MODEL_DIR=/root/.cache/modelscope/hub/iic_CosyVoice2-0.5B
# 命名音色 "xiaoxi" 的参考音频（16kHz 单声道 WAV，放到 ./voices/ 下，容器内挂载为 /opt/voices，只读）
XIAOXI_PROMPT_WAV=/opt/voices/xiaoxi_16k.wav
# 参考音频里念的那句话的准确转录（零样本音色克隆的 prompt text，必须逐字对应，否则合成效果会变差）
XIAOXI_PROMPT_TEXT=参考音频里念的那句话的准确转录
